HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Empty optional values are ignored. Apply migrations before configuring the DB.
DATABASE_URL=
BASE_SEPOLIA_RPC_URL=
OWNER_ADDRESS=
KERNEL_ACCOUNT_ADDRESS=
GUARDIAN_ADDRESS=
AUTH_DOMAIN=localhost:3000
AI_PROVIDER=groq
AI_MODEL_ID=openai/gpt-oss-120b
# Comparator: openai/gpt-oss-20b. Qwen remains an explicitly selected alternative.
# GPT-OSS completion budget includes reasoning, even with include_reasoning=false.
AI_OUTPUT_TOKENS=1024
# Keep the Groq account on Free; this flag records the operator's confirmation.
# It cannot inspect/override the provider account's billing tier.
GROQ_API_KEY=
GROQ_FREE_TIER_CONFIRMED=false
# Legacy local transport is opt-in with AI_PROVIDER=ollama, AI_MODEL_ID=qwen3:8b.
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_REQUEST_TIMEOUT_MS=30000
AI_CONTEXT_TOKENS=4096
# Only for an authenticated self-hosted gateway; local Ollama needs no token.
OLLAMA_API_TOKEN=
PROVIDER_AGENT_URL=
PROVIDER_AGENT_TOKEN=
PROVIDER_SIGNER_URL=
PROVIDER_SIGNER_TOKEN=
# Local provider:configure populates these; use private service endpoints in hosting.
# Set AI_PROVIDER=baseline explicitly for the deterministic evaluation baseline.
# Do not put a signing key in the API/planner environment.
