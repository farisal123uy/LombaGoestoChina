HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Empty optional values are ignored. Apply migrations before configuring the DB.
DATABASE_URL=
BASE_SEPOLIA_RPC_URL=
OWNER_ADDRESS=
KERNEL_ACCOUNT_ADDRESS=
GUARDIAN_ADDRESS=
AUTH_DOMAIN=localhost:3000
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_MODEL_ID=qwen3:8b
AI_REQUEST_TIMEOUT_MS=45000
AI_CONTEXT_TOKENS=4096
# Only for an authenticated self-hosted gateway; local Ollama needs no token.
OLLAMA_API_TOKEN=
PROVIDER_AGENT_URL=
PROVIDER_AGENT_TOKEN=
PROVIDER_SIGNER_URL=
PROVIDER_SIGNER_TOKEN=
# Local provider:configure populates these; use private service endpoints in hosting.
# Set AI_PROVIDER=baseline explicitly for the deterministic evaluation baseline.
# Do not put a signing key in the API/planner environment.
