WORKER_INTERVAL_MS=2000
BATCH_MAX_SIZE=1
BATCH_WINDOW_MS=0
# Opt-in after migrations: size 2..10; window 0..30000ms, bounded by plan expiry.
EXECUTION_ENABLED=false
# Enable only after the account/module/session have been configured by its owner.
DATABASE_URL=
BASE_SEPOLIA_RPC_URL=
ZERODEV_RPC_URL=
KERNEL_ACCOUNT_ADDRESS=
GUARDIAN_ADDRESS=
AGENT_SESSION_PRIVATE_KEY=
SESSION_VALID_UNTIL=
# Optional OWNER signature of getGuardianSessionAuthorization().typedData;
# omit if permission is already installed. This is not the owner's private key.
SESSION_ENABLE_SIGNATURE=
MAX_GAS_COST_WEI=1000000000000000
CONFIRMATIONS=2
GAS_MODE=native
# Required when GAS_MODE=sponsored. No fallback to an unapproved paymaster/native mode.
APPROVED_PAYMASTER_ADDRESS=
PROVIDER_SIGNER_URL=
PROVIDER_SIGNER_TOKEN=
PROVIDER_SIGNER_ADDRESS=
# MAX_GAS_COST_WEI caps estimated ERC-4337 native gas exposure per operation;
# it is not a measured all-in USD/L1-fee or cumulative gas-spend policy.
# Never expose the executor secret through NEXT_PUBLIC_* or planner input.
