FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/reviewer/package.json apps/reviewer/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/planner/package.json packages/planner/package.json
COPY packages/wallet/package.json packages/wallet/package.json
COPY packages/database/package.json packages/database/package.json
COPY contracts/package.json contracts/package.json
RUN npm ci
COPY . .
RUN npm run build

FROM build AS runtime-dependencies
RUN npm prune --omit=dev

FROM node:22-bookworm-slim AS review
WORKDIR /app
# apps/reviewer declares minimal Hardhat/viem/PGlite production dependencies.
# Build-only lint/browser/migration tooling is pruned from the final image.
COPY --chown=node:node --from=runtime-dependencies /app /app
ENV NODE_ENV=production
ENV PORT=7860
ENV REVIEW_MAX_SESSIONS=1
EXPOSE 7860
USER node
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/api/review/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "tools/review/serve.mjs"]
