# Server secrets: use the hosting provider's secret environment, not Git/browser.
GROQ_API_KEY=
GROQ_FREE_TIER_CONFIRMED=false
REVIEW_ACCESS_CODE=
# GPT-OSS 120B is the candidate default; change explicitly for a measured comparison.
AI_PROVIDER=groq
AI_MODEL_ID=openai/gpt-oss-120b
AI_REQUEST_TIMEOUT_MS=30000
AI_OUTPUT_TOKENS=1024
AI_CONTEXT_TOKENS=4096
REVIEW_MAX_SESSIONS=1
# Optional public build marker: full 40-character Git SHA or 64-character source SHA-256.
# No secret/API key is accepted in this field.
REVIEW_BUILD_ID=development
PORT=7860
# Fork reads only; all transactions are executed on the isolated in-process chain.
KERNEL_FORK_RPC_URL=https://sepolia.base.org
